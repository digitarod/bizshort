# ============================================================
# bizshort — 環境変数設定例
# このファイルをコピーして .env を作成し、APIキーを設定してください
# cp .env.example .env
# ============================================================

# --- 画像生成 API (使用するプロバイダーのキーのみ設定) ---

# Fal.ai (デフォルト・最安) https://fal.ai/dashboard/keys
FAL_KEY=

# Google Gemini (直接) https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (DALL-E 3 / gpt-image-1) https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- サーバー設定 ---
PORT=3000
